# Server & Application URL
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Cryptographic Secrets (MUST be set to strong random 32+ byte secrets in production)
JWT_SECRET="REPLACE_WITH_64_CHAR_HEX_JWT_SECRET"
WEBHOOK_ENCRYPTION_KEY="REPLACE_WITH_64_CHAR_HEX_AES_KEY"
DEVICE_HMAC_PEPPER="REPLACE_WITH_64_CHAR_HEX_PEPPER"

# MySQL 8 Database Configuration (Leave MYSQL_HOST empty to use local SQLite fallback in dev)
MYSQL_HOST=""
MYSQL_PORT=3306
MYSQL_USER="takaledger"
MYSQL_PASSWORD=""
MYSQL_DATABASE="takaledger_gateway"
MYSQL_SSL="false"

# Authorized Provider Verification API Credentials (Optional; never store real secrets in repo)
BKASH_API_BASE_URL="https://tokenized.pay.bka.sh/v1.2.0-beta"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

NAGAD_API_BASE_URL="https://api.mynagad.com/api/dfs"
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""
NAGAD_PG_PUBLIC_KEY=""

ROCKET_API_BASE_URL=""
ROCKET_MERCHANT_ID=""
ROCKET_API_SECRET=""

# Initial Bootstrap Admin (used only if users table is empty on first boot)
BOOTSTRAP_ADMIN_EMAIL="admin@takaledger.bd"
BOOTSTRAP_ADMIN_PASSWORD=""

# Optional AI Studio runtime variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
